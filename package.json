{
  "name": "world-viewer",
  "version": "1.0.0",
  "productName": "WORLD VIEWER",
  "description": "A professional geospatial intelligence desktop application — photorealistic 3D globe, live air/sea/space/earth signals, world events, and contextual AI.",
  "private": true,
  "main": "electron/main/index.cjs",
  "type": "module",
  "author": "WORLD VIEWER",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cd sources/gods-eye-view-main && npm run dev -- --host localhost --port 4173",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:4173 && electron .\"",
    "build:renderer": "cd sources/gods-eye-view-main && npm run build",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "test": "cd sources/gods-eye-view-main && node scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.worldviewer.app",
    "productName": "WORLD VIEWER",
    "artifactName": "world-viewer-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "sources/gods-eye-view-main/dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Science"
    }
  }
}
